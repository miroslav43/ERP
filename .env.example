# ─────────────────────────────────────────────────────────────────────────────
# Administrativo — variabile de mediu
# Copiază în `.env.local` și completează. `.env.local` NU se comite niciodată.
# Fiecare variabilă este validată la boot în `src/config/env.ts`; o valoare
# lipsă sau invalidă oprește aplicația imediat, nu la primul request.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# URL-ul și cheia publică ajung în bundle-ul de client — sunt publice prin design,
# protecția reală este RLS.
NEXT_PUBLIC_SUPABASE_URL="https://nybmhorngsajoqaxjlbr.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ⚠️ OCOLEȘTE COMPLET RLS. Se folosește EXCLUSIV în `src/lib/supabase/admin.ts`
# (marcat `server-only`), doar pentru operațiuni de super-admin, fiecare cu
# comentariu care explică de ce. Nu ajunge NICIODATĂ în cod de client.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Criptarea datelor sensibile (CNP, IBAN) ──────────────────────────────────
# AES-256-GCM. Format: JSON cu versiuni de cheie, pentru rotație fără
# re-criptarea întregii baze. Fiecare cheie: 32 de octeți, codificați base64.
# Generare: openssl rand -base64 32
# Pierderea cheilor = pierderea definitivă a CNP-urilor și IBAN-urilor.
HR_ENCRYPTION_KEYS='{"1":""}'
HR_ENCRYPTION_ACTIVE_KEY="1"

# Cheie separată, pentru amprentele de deduplicare a CNP-ului și IBAN-ului.
# Nu se folosește la criptare. Un hash fără cheie peste 13 cifre structurate se
# sparge prin dicționar; HMAC-ul îl face inutil fără cheie.
# Generare: openssl rand -base64 32
HR_HASH_KEY=""

# ── Cookie de organizație activă ─────────────────────────────────────────────
# Semnătura HMAC nu este stratul de securitate (acela e RLS), ci detectorul de
# tampering care ne permite să scriem încercarea în `audit_logs`.
# Generare: openssl rand -base64 32
TENANT_COOKIE_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Cât timp DNS-ul nu e configurat, lasă EMAIL_MODE="test": nu se trimite nimic
# real, totul se scrie în tabela `email_log` și se vede din Super-Admin.
EMAIL_MODE="test"
RESEND_API_KEY=""
EMAIL_FROM="Administrativo <noreply@administrativo.ro>"
RESEND_WEBHOOK_SECRET=""

# ── Aplicație ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── REGES-Online ─────────────────────────────────────────────────────────────
# Secretul cu care timerul de pe gazdă pornește ciclul de reconciliere —
# comanda exactă e în `deploy/reges-reconciliere.service`. NU prin
# `-H "Authorization: Bearer $..."` (secretul ajunge în argv, deci în `ps`) și
# NU spre `127.0.0.1:3000` (serviciul Swarm nu publică porturi):
#   printf 'oauth2-bearer = %s\n' "$REGES_CRON_SECRET" \
#     | curl -sS -K - --resolve administrativo.ro:443:127.0.0.1 \
#            -X POST https://administrativo.ro/api/reges/reconciliere
# Cât timp e gol, ruta refuză orice cerere — ciclul e OPRIT, nu deschis.
# Generare: openssl rand -base64 32
# Cheile API propriu-zise NU stau aici: sunt per firmă-client, criptate în
# `reges_credentiale`, introduse din ecranul REGES-Online → Chei API.
REGES_CRON_SECRET=""

# ── Notificări push (aplicația mobilă) ───────────────────────────────────────
# Secretul cu care timerul de pe gazdă golește coada `push_livrari`:
#   deploy/push-livrare.{service,timer} → POST /api/push/livreaza
# Cât timp e gol, ruta răspunde 404 la ORICE cerere — coada nu se golește
# niciodată și nicio notificare nu ajunge pe telefon. Nu e o eroare vizibilă
# nicăieri: rândurile doar se adună.
# Generare: openssl rand -base64 32
# ACEEAȘI valoare trebuie să existe în TREI locuri, altfel lanțul tace:
#   1. `.env.production` de pe VM  — de-acolo o citește `stack:deploy`;
#   2. `docker-stack.yml`, în `environment:` — Swarm NU propagă ce nu e
#      enumerat acolo (a lipsit până la revizuirea finală);
#   3. `/etc/administrativo/push.env` (0600, root) — mediul timerului.
PUSH_CRON_SECRET=""

# ── Asistent AI ──────────────────────────────────────────────────────────────
# Bula din dreapta-jos. Cât timp cheia e goală, /api/asistent răspunde 404 și
# bula nu se randează nicăieri — indiferent dacă modulul `asistent` e activ
# pentru firmă. Cheia se ia de la https://openrouter.ai/keys (prefix sk-or-v1).
OPENROUTER_API_KEY=""
# Modelul se schimbă de aici, fără deploy de cod.
OPENROUTER_MODEL_ASISTENT="google/gemini-3.7-flash"
