# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secretele nu se comit niciodată, dar șablonul da
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase — starea locală a CLI-ului; migrările DA se comit
supabase/.temp
supabase/.branches

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
# Capturi, snapshot-uri și log-uri lăsate de serverul MCP Playwright.
/.playwright-mcp

# Capturi de ecran lăsate la rădăcină în timpul lucrului.
/image*.png

# Claude Code — componentele de proiect (.claude/agents, .claude/skills,
# .claude-plugin) SE COMIT deliberat: vin cu `git clone` și se încarcă automat.
# Excepțiile sunt strict locale, per mașină.
.claude/settings.local.json
.claude/RESUME.md
